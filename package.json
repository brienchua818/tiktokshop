{
  "name": "tikshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TikTok Shop live-listing and orders console for HOUZE, Table Matters and Painting Matters",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run && node apps-script/test/run.cjs",
    "test:web": "vitest run",
    "test:apps-script": "node apps-script/test/run.cjs",
    "check:devices": "npm run build && node tools/device-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^2.20.0",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^11.0.3",
    "cloudinary": "^2.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
